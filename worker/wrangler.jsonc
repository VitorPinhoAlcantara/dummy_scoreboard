{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dummyscoreboard-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dummyscoreboard",
      "database_id": "2b3f23c9-bf0a-4772-a35b-1a55a1833260"
    }
  ],
  // Per-IP request caps, free on any plan (no KV/D1 cost). Well above what the mod itself ever
  // generates naturally (see worker/README notes) - this exists to stop someone hammering the
  // endpoints directly, not to throttle normal usage.
  "ratelimits": [
    { "name": "RATE_LIMITER_GET", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RATE_LIMITER_SUBMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ]
}
