{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dummyscoreboard-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dummyscoreboard",
      // Placeholder - only `wrangler dev` (local mode, the default) is expected to work with
      // this. Run `npm run db:create` to make a real D1 database and replace this with the id it
      // prints before ever running `wrangler deploy`.
      "database_id": "local-only-placeholder-id"
    }
  ]
}
